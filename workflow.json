      "name": "Ler README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ],
      "id": "a7a4303e-ecb1-43c3-bd2e-12317081ff29",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const repos = $('Separar repositorios').all().map(i => i.json);\nconst readmes = $input.all().map(i => typeof i.json.data === 'string' ? i.json.data.slice(0, 3000) : '');\nconst blocos = repos.map((r, i) => `REPO: ${r.repo}\nDESCRICAO: ${r.descricao}\nMETRICAS: ${r.estrelas} estrelas (${r.motivo}), ${r.forks} forks, ${r.issues} issues abertas, criado em ${r.criado}, ultimo push em ${r.ultimoPush}\nREADME:\n${readmes[i] || '(sem README)'}`);\nconst prompt = `Voce avalia repositorios de skills para o Claude Code. O leitor e um estudante de Engenharia de Computacao que usa o Claude Code todo dia e quer ser AI Engineer.\n\nPara cada repositorio, responda em portugues, em frases curtas:\n- o_que_e: o que o repositorio e, em 1 frase.\n- para_quem: que tipo de pessoa ou projeto aproveita.\n- para_que: que tarefa ele resolve na pratica.\n- veredito: \"usar\" (solido e util para o leitor), \"testar\" (promissor, mas novo ou pouco provado) ou \"ignorar\" (hype, so lista de links, abandonado ou fora do tema).\n- motivo: por que esse veredito, em 1 frase, citando as metricas quando ajudarem.\n\nMuitas estrelas e push recente indicam projeto vivo. Repositorio novo com README vago indica hype. Nao invente nada que nao esteja no README ou nas metricas. Use o nome do repositorio exatamente como aparece em REPO.\n\n` + blocos.join('\\n\\n---\\n\\n');\nreturn [{ json: { prompt } }];"
      },
      "name": "Montar prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        0
      ],
      "id": "01f9a254-5c02-414e-b633-051d4a288381"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: $json.prompt }] }],\n  generationConfig: {\n    temperature: 0.2,\n    responseMimeType: \"application/json\",\n    responseSchema: {\n      type: \"ARRAY\",\n      items: {\n        type: \"OBJECT\",\n        properties: {\n          repo: { type: \"STRING\" },\n          o_que_e: { type: \"STRING\" },\n          para_quem: { type: \"STRING\" },\n          para_que: { type: \"STRING\" },\n          veredito: { type: \"STRING\", enum: [\"usar\", \"testar\", \"ignorar\"] },\n          motivo: { type: \"STRING\" }\n        },\n        required: [\"repo\", \"o_que_e\", \"para_quem\", \"para_que\", \"veredito\", \"motivo\"]\n      }\n    }\n  }\n}) }}",
        "options": {}
      },
      "name": "Gemini avalia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2208,
        0
      ],
      "id": "0682c406-e377-4573-b698-d04e5c93614d"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst repos = Object.fromEntries($('Separar repositorios').all().map(i => [i.json.repo, i.json]));\nconst analises = JSON.parse($input.first().json.candidates[0].content.parts[0].text);\nconst ordem = { usar: 0, testar: 1, ignorar: 2 };\nconst linhas = analises\n  .filter(a => repos[a.repo])\n  .sort((a, b) => ordem[a.veredito] - ordem[b.veredito])\n  .map(a => {\n    const r = repos[a.repo];\n    return `[${a.veredito.toUpperCase()}] ${a.repo}\n${r.estrelas} estrelas, ${r.motivo}, ultimo push ${r.ultimoPush}\n${a.o_que_e}\nPara quem: ${a.para_quem}\nPara que: ${a.para_que}\nPor que: ${a.motivo}\n${r.url}`;\n  });\nconst mensagem = `Skills do Claude Code: ${linhas.length} novidade(s) hoje\\n\\n` + linhas.join('\\n\\n');\nreturn [{ json: { mensagem: mensagem.slice(0, 4000), chatId: cfg.chatId } }];"
      },
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        0
      ],
      "id": "f2dd2bf2-04d7-4e4f-b7b8-e848b880b7b7"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nreturn [{ json: { mensagem: `Skills do Claude Code: nada novo hoje (${$json.analisados} repositorios conferidos).`, chatId: cfg.chatId } }];"
      },
      "name": "Mensagem sem novidade",
