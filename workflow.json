    {
      "parameters": {},
      "name": "Juntar",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        880,
        96
      ],
      "id": "3ffab947-f085-4d73-8cb0-eb8946ca365e"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst memoria = $getWorkflowStaticData('global');\nmemoria.estrelas = memoria.estrelas || {};\nconst repos = {};\nfor (const { json: j } of $input.all()) {\n  for (const r of (j.items || [j])) if (r.full_name) repos[r.full_name] = r;\n}\nconst candidatos = [];\nfor (const r of Object.values(repos)) {\n  const antes = memoria.estrelas[r.full_name];\n  const ganho = antes === undefined ? null : r.stargazers_count - antes;\n  const item = {\n    repo: r.full_name, url: r.html_url, descricao: r.description || '',\n    estrelas: r.stargazers_count, ganho, forks: r.forks_count, issues: r.open_issues_count,\n    criado: r.created_at.slice(0, 10), ultimoPush: r.pushed_at.slice(0, 10),\n    motivo: antes === undefined ? 'novo no radar' : `+${ganho} estrelas desde a ultima vez`,\n  };\n  if (antes === undefined || ganho >= cfg.saltoEstrelas) candidatos.push(item);\n  else memoria.estrelas[r.full_name] = r.stargazers_count;\n}\ncandidatos.sort((a, b) => (b.ganho ?? b.estrelas) - (a.ganho ?? a.estrelas));\nconst novos = candidatos.slice(0, cfg.maxItens);\n// Os que ficaram de fora nao entram na memoria, para aparecer num dia seguinte.\nfor (const n of novos) memoria.estrelas[n.repo] = n.estrelas;\nreturn [{ json: { novos, analisados: Object.keys(repos).length } }];"
      },
      "name": "Filtrar novidades",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
