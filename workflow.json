    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            }
          ]
        },
